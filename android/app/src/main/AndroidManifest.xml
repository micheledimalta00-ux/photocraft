<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Opening and saving go through the system pickers (gallery, camera, documents), which
         need no permission. These are only for the in-app folder browser (choosing a folder);
         Android 11+ grants it through "All files access" in Settings. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- wgpu renders with Vulkan, falling back to OpenGL ES 3. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- The camera app is asked to take the photo; PhotoCraft never opens the camera itself. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="PhotoCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".PhotoCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">

            <!-- libphotocraft_android.so, built from apps/photocraft-android -->
            <meta-data android:name="android.app.lib_name" android:value="photocraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
